# Node Environment
NODE_ENV=development
PORT=5001

# Security & Secrets
JWT_SECRET=replace-with-a-secure-random-64-char-string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SHARED_SECRET=suraksha-secure-hmac-shared-key-2026

# Domains & URLs
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_DOMAIN=http://localhost:5173

# Demo Mode Configuration
DEMO_MODE=true
DEMO_PHONE_NUMBER=+91XXXXXXXXXX
DEMO_EMAIL=demo@surakshayatra.gov.in

# SMS Provider Configuration (Twilio / Mock / MSG91)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# DPDP Act Compliance
DPDP_RETENTION_DAYS=30
